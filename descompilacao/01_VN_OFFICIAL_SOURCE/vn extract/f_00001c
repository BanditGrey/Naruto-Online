    }

    var appId = '';
    if (typeof(APP_ID_MOBILE) != 'undefined') {
        appId = APP_ID_MOBILE;
    }

    social_access_token = response.credential;

    if (typeof social_access_token == 'undefined' || !social_access_token) {
        warning('Không kết nối được đến tài khoản Google', '');
        hide_loading();
