function preventDuplicateSubmit(form, timeout = 2000) {
    if (form.data('submitting')) {
        return false;
    }
    form.data('submitting', true);
    setTimeout(function() {
        form.data('submitting', false);
    }, timeout);
    return true;
}

function getAjaxCsrfToken() {
    return $('input[name="csrf"]').first().val() || '';
}

function updateAjaxCsrfToken(token) {
    if (!token) {
        return;
    }
    $('input[name="csrf"]').val(token);
}

function syncAjaxCsrf(response) {
    if (response && response.data && response.data.csrf) {
        updateAjaxCsrfToken(response.data.csrf);
    }
}


