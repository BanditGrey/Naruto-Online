function handleAppleLoginResponse(response){
    var redirect_url = get_redirect_url();
    if (redirectAuthencationSubpage !== undefined) {
        redirect_url = redirectAuthencationSubpage;
    }

    // Apple trả về authorization object với id_token
    var idToken = response.authorization.id_token;
