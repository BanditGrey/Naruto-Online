function getChromeVersion(userAgent) {
  const match = userAgent.match(/Chrome\/([\d.]+)/);
  return match ? match[1] : null;
}

function detectOldBrowser(userAgent) {
    var oldBrowser = 'browserDefault';

    if ((userAgent || '').indexOf('Puffin/') !== -1) {
        oldBrowser = 'Puffin';
    } else if ((userAgent || '').indexOf('UBrowser') !== -1) {
        oldBrowser = 'UBrowser';
    } else if ((userAgent || '').indexOf('37abc') !== -1) {
        oldBrowser = '37abc';
    } else if (getChromeVersion(userAgent) > 0 && getChromeVersion(userAgent) < 34) {
        oldBrowser = 'Coowon';
    }

    return oldBrowser;
}

function isOldBrowser() {
    return detectOldBrowser(navigator.userAgent) !== 'browserDefault';
}

