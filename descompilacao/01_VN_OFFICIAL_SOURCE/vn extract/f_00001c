    if (typeof AUTO_REDIRECT != 'undefined' && AUTO_REDIRECT && $.cookie('display_name') && get_user_login()) {
        if (typeof(APP_ID_MOBILE) != 'undefined') {

            var paramUrl = parse_url(document.URL);
            var appId = '';
            if (typeof paramUrl['app_id'] != 'undefined') {
                appId = paramUrl['app_id'];
            }

            if (typeof appId != 'undefined' && ['phongthantdd', '3qgoituongdi'].includes(appId)) {
                redirect('https://568play.vn/auth/redirecting?app_id=' + appId + '&redirect_url=' + get_redirect_url());
                return;
            }
        }

        if (get_redirect_top()) {
            redirect_top(decodeURIComponent(get_redirect_url()));
        } else if (get_redirect_url()) {
            redirect(decodeURIComponent(get_redirect_url()));
        }
    }
